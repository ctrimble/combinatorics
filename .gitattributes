# 1. Handle text files automatically (Normalize to LF in the repo)
* text=auto

# 2. Force specific line endings for specific text file types
*.sh      text eol=lf
*.bash    text eol=lf
*.xml     text eol=lf
*.json    text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# 3. Explicitly mark binary files (Do not modify their line endings)
*.png     binary
*.jpg     binary
*.gif     binary
*.pdf     binary
